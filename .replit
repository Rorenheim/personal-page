modules = ["python-base-3.13"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m http.server 5000 --bind 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["python3", "scripts/build_static.py"]
publicDir = "generated-artifacts/site"

[[deployment.responseHeaders]]
path = "/"
name = "Cache-Control"
value = "public, no-cache"

[[deployment.responseHeaders]]
path = "/*.html"
name = "Cache-Control"
value = "public, no-cache"

[[deployment.responseHeaders]]
path = "/css/*"
name = "Cache-Control"
value = "public, no-cache"

[[deployment.responseHeaders]]
path = "/js/*"
name = "Cache-Control"
value = "public, no-cache"

[[deployment.responseHeaders]]
path = "/vendor/*"
name = "Cache-Control"
value = "public, no-cache"

[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"
